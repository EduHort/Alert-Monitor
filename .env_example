# Chave da API do Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Conta Gmail usada para enviar os alertas.
# EMAIL_PASS deve ser uma "Senha de app" do Google, não a senha da conta.
EMAIL_USER=
EMAIL_PASS=

# Destinatários separados por vírgula.
# EMAIL_CLIENTS recebe o resumo; EMAIL_ADMIN recebe o relatório técnico com as falhas.
# Pelo menos um dos dois precisa estar preenchido.
EMAIL_CLIENTS=
EMAIL_ADMIN=
